# Dependencies — rebuilt by `npm install`, never committed
node_modules/

# Local database and uploads — created at runtime
social_coding.db
social_coding.db-journal
uploads/

# Secrets — the deployment sets these as environment variables instead
.env
.env.local

# Native Android project — regenerated by `npx cap add android`
android/
ios/

# Logs and editor noise
*.log
.DS_Store
Thumbs.db
